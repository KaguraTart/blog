---
import { getCollection } from 'astro:content';
import BlogPostPage from '../../../components/BlogPostPage.astro';
import { defaultLocale, routeLocales } from '../../../i18n/config.mjs';
import {
  assertUniquePostSlugs,
  getAvailablePostLocales,
  getLocalizedPost,
  getPostBaseSlug,
  getPostLocale,
  isDefaultLocalePost,
} from '../../../i18n/utils.mjs';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  assertUniquePostSlugs(posts);
  const basePosts = posts.filter(isDefaultLocalePost);
  const basePostsBySlug = new Map(
    basePosts.map(basePost => [getPostBaseSlug(basePost), basePost]),
  );
  const availableByLocale = new Map<string, Set<string>>(
    routeLocales.map(locale => [locale, new Set<string>()]),
  );

  for (const post of posts) {
    const locale = getPostLocale(post);
    if (locale === defaultLocale) continue;

    const baseSlug = getPostBaseSlug(post);
    if (basePostsBySlug.has(baseSlug)) {
      availableByLocale.get(locale)?.add(baseSlug);
    }
  }

  return routeLocales.flatMap(locale => {
    const baseSlugs = availableByLocale.get(locale);
    if (!baseSlugs) return [];

    return Array.from(baseSlugs).map(baseSlug => {
      const basePost = basePostsBySlug.get(baseSlug);
      return {
        params: { locale, slug: baseSlug },
        props: {
          locale,
          post: getLocalizedPost(basePost, locale, posts),
          nativeLocaleCodes: getAvailablePostLocales(basePost, posts),
        },
      };
    });
  });
}

const { post, locale, nativeLocaleCodes } = Astro.props;
---

<BlogPostPage post={post} locale={locale} nativeLocaleCodes={nativeLocaleCodes} />
